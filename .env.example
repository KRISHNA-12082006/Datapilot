# DataPilot AI - environment variables. Copy to .env

# REQUIRED: PostgreSQL connection string. Then run `npm run db:init` once.
DATABASE_URL="postgresql://user:password@localhost:5432/datapilot?schema=public"

# OPTIONAL: Anthropic API key. When set, intent extraction uses a real LLM
# (src/lib/server/ai.ts). When empty, a local keyword heuristic is used.
AI_API_KEY="""
# Reserved for real data-source connectors (collection is simulated today)
SEARCH_API_KEY=""
NEWS_API_KEY=""
COMPANY_REGISTRY_API_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
